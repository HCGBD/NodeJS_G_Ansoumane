<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Node Formation</title>
    <link rel="stylesheet" href="../node_modules/bootstrap/dist/css/bootstrap.min.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"
        integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
</head>

<body>
    <h1 class="text-center mt-3">Initiation en Node JS</h1>
    <div class="container mt-5">
        <div class="row d-flex justify-content-center flex-column">
            <div class="col mb-4">
                <!-- <button type="button" class="btn btn-primary">Ajouter un(e) Candidate</button> -->
                <!-- Button trigger modal -->
                <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#exampleModal">
                    Ajouter un(e) etudiant(e)
                </button>

                <!-- Modal -->
                <div class="modal fade" id="exampleModal" tabindex="-1" aria-labelledby="exampleModalLabel"
                    aria-hidden="true">
                    <div class="modal-dialog">
                        <div class="modal-content">
                            <div class="modal-header">
                                <h5 class="modal-title" id="exampleModalLabel">Enregistrement </h5>
                                <button type="button" class="btn-close" data-bs-dismiss="modal"
                                    aria-label="Close"></button>
                            </div>
                            <div class="modal-body">
                                <form method="post" action="/ajout">
                                    <input type="hidden" name="statut" id="statut" value="">
                                    <div class="form-floating mb-3">
                                        <input type="text"
                                            class="form-control  border border-primary border-2 rounded-3"
                                            id="matricule" placeholder="name@example.com" name="matricule">
                                        <label for="floatingInput">Matricule</label>
                                    </div>
                                    <div class="form-floating mb-3">
                                        <input type="text"
                                            class="form-control  border border-primary border-2 rounded-3" id="nom"
                                            placeholder="name@example.com" name="nom">
                                        <label for="floatingInput">Nom</label>
                                    </div>
                                    <div class="form-floating mb-3">
                                        <input type="text"
                                            class="form-control  border border-primary border-2 rounded-3" name="prenom"
                                            id="prenom" placeholder="name@example.com">
                                        <label for="floatingInput">Prenom</label>
                                    </div>
                                    <div class="form-floating mb-3">
                                        <input type="tel" class="form-control  border border-primary border-2 rounded-3"
                                            name="telephone" id="telephone" placeholder="name@example.com">
                                        <label for="floatingInput">Telephone</label>
                                    </div>
                                    <div class="form-floating mb-3">
                                        <input type="text"
                                            class="form-control border border-primary border-2 rounded-3 " id="adresse"
                                            placeholder="name@example.com" name="adresse">
                                        <label for="floatingInput">Adresse</label>
                                    </div>

                                    <!-- <button type="submit" class="btn btn-primary">Enregistrer</button> -->

                            </div>
                            <div class="modal-footer">
                                <button type="reset" class="btn btn-danger" data-bs-dismiss="modal">Annuler</button>
                                <button type="submit" name="ajouter" id="btnAM"
                                    class="btn btn-success">Enregistrer</button>
                            </div>

                            </form>
                        </div>
                    </div>
                </div>

            </div>
            <div class="col">
                <table class="table table-striped-columns border-primary">
                    <thead>
                        <tr>
                            <th>Matricule</th>
                            <th>Nom</th>
                            <th>Prénom</th>
                            <th>Telephone</th>
                            <th>Adresse</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% for(let item of result){ %>
                            <tr>
                                <td>
                                    <%= item.matricule %>
                                </td>
                                <td>
                                    <%= item.nom %>
                                </td>
                                <td>
                                    <%= item.prenom %>
                                </td>
                                <td>
                                    <%= item.telephone %>
                                </td>
                                <td>
                                    <%= item.adresse %>
                                </td>
                                <td>
                                    <div>
                                        <button
                                            onclick="editer('<%= item.matricule %>',  '<%= item.nom %>',' <%= item.prenom %>',' <%= item.telephone %>','  <%= item.adresse %>')"
                                            type="button" data-bs-toggle="modal" data-bs-target="#exampleModal"
                                            id="edit" class="btn btn-info"> <svg xmlns="http://www.w3.org/2000/svg"
                                                width="16" height="16" fill="currentColor" class="bi bi-pencil-fill"
                                                viewBox="0 0 16 16">
                                                <path
                                                    d="M12.854.146a.5.5 0 0 0-.707 0L10.5 1.793 14.207 5.5l1.647-1.646a.5.5 0 0 0 0-.708zm.646 6.061L9.793 2.5 3.293 9H3.5a.5.5 0 0 1 .5.5v.5h.5a.5.5 0 0 1 .5.5v.5h.5a.5.5 0 0 1 .5.5v.5h.5a.5.5 0 0 1 .5.5v.207zm-7.468 7.468A.5.5 0 0 1 6 13.5V13h-.5a.5.5 0 0 1-.5-.5V12h-.5a.5.5 0 0 1-.5-.5V11h-.5a.5.5 0 0 1-.5-.5V10h-.5a.5.5 0 0 1-.175-.032l-.179.178a.5.5 0 0 0-.11.168l-2 5a.5.5 0 0 0 .65.65l5-2a.5.5 0 0 0 .168-.11z" />
                                            </svg> Modifier </button>
                                        <button type="button" id="sup" class="btn btn-danger" data-bs-toggle="modal" onclick="attributeMat('<%= item.matricule %>')"
                                            data-bs-target="#supModal"> <svg xmlns="http://www.w3.org/2000/svg"
                                                width="16" height="16" fill="currentColor" class="bi bi-trash3"
                                                viewBox="0 0 16 16">
                                                <path
                                                    d="M6.5 1h3a.5.5 0 0 1 .5.5v1H6v-1a.5.5 0 0 1 .5-.5M11 2.5v-1A1.5 1.5 0 0 0 9.5 0h-3A1.5 1.5 0 0 0 5 1.5v1H1.5a.5.5 0 0 0 0 1h.538l.853 10.66A2 2 0 0 0 4.885 16h6.23a2 2 0 0 0 1.994-1.84l.853-10.66h.538a.5.5 0 0 0 0-1zm1.958 1-.846 10.58a1 1 0 0 1-.997.92h-6.23a1 1 0 0 1-.997-.92L3.042 3.5zm-7.487 1a.5.5 0 0 1 .528.47l.5 8.5a.5.5 0 0 1-.998.06L5 5.03a.5.5 0 0 1 .47-.53Zm5.058 0a.5.5 0 0 1 .47.53l-.5 8.5a.5.5 0 1 1-.998-.06l.5-8.5a.5.5 0 0 1 .528-.47M8 4.5a.5.5 0 0 1 .5.5v8.5a.5.5 0 0 1-1 0V5a.5.5 0 0 1 .5-.5" />
                                            </svg> Supprimer</button>
                                    </div>
                                </td>

                            </tr>

                            <% }%>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Modal -->
    <div class="modal fade" id="supModal" tabindex="-1" aria-labelledby="supModal" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="exampleModalLabel">Suppression</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    Voulez-vous vraiment supprimer cet enregistrement ?
                </div>
                <form action="/sup" method="post">
                    <input type="hidden" name="idSup" id="idSup" value="">
                    <div class="modal-footer">
                        <button type="button" class="btn btn-success" data-bs-dismiss="modal">Non</button>
                        <button type="submit" class="btn btn-danger">Oui</button>
                    </div>
                </form>
            </div>
        </div>
    </div>


    <script src="../node_modules/bootstrap/dist/js/bootstrap.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
        integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz"
        crossorigin="anonymous"></script>

    <script>
        const form = document.querySelector("form")
        const button = document.querySelector('#btnAM')

        form.appendChild(input)
        function editer(matricule, nom, prenom, telephone, adresse) {
            document.getElementById('matricule').value = matricule;
            document.getElementById('nom').value = nom;
            document.getElementById('prenom').value = prenom;
            document.getElementById('telephone').value = telephone;
            document.getElementById('adresse').value = adresse;

            document.getElementById('statut').value = 'modif'
            const input = document.createElement('input');
            input.type = 'hidden';
            input.name = 'matModif';
            input.value = matricule
            form.appendChild(input)

            button.textContent = "Modifier"


        }

       function attributeMat(matricule){
            document.getElementById("idSup").value=matricule
        }
    </script>
</body>

</html