<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Node Formation</title>
    <link rel="stylesheet" href="../node_modules/bootstrap/dist/css/bootstrap.min.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"
        integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
</head>

<body>
    <h1 class="text-center mt-3">Initiation en Node JS</h1>
    <div class="container mt-5">
        <div class="row d-flex justify-content-center flex-column">
            <div class="col mb-4">
                <!-- <button type="button" class="btn btn-primary">Ajouter un(e) Candidate</button> -->
                <!-- Button trigger modal -->
                <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#exampleModal">
                    Ajouter un(e) etudiant(e)
                </button>

                <!-- Modal -->
                <div class="modal fade" id="exampleModal" tabindex="-1" aria-labelledby="exampleModalLabel"
                    aria-hidden="true">
                    <div class="modal-dialog">
                        <div class="modal-content">
                            <div class="modal-header">
                                <h5 class="modal-title" id="exampleModalLabel">Enregistrement </h5>
                                <button type="button" class="btn-close" data-bs-dismiss="modal"
                                    aria-label="Close"></button>
                            </div>
                            <div class="modal-body">
                                <form method="post" action="/ajout">
                                    <div class="form-floating mb-3">
                                        <input type="text"
                                            class="form-control  border border-primary border-2 rounded-3"
                                            id="floatingInput" placeholder="name@example.com" name="matricule">
                                        <label for="floatingInput" >Matricule</label>
                                    </div>
                                    <div class="form-floating mb-3">
                                        <input type="text"
                                            class="form-control  border border-primary border-2 rounded-3"
                                            id="floatingInput" placeholder="name@example.com" name="nom">
                                        <label for="floatingInput" >Nom</label>
                                    </div>
                                    <div class="form-floating mb-3">
                                        <input type="text"
                                            class="form-control  border border-primary border-2 rounded-3" name="prenom"
                                            id="floatingInput" placeholder="name@example.com">
                                        <label for="floatingInput" >Prenom</label>
                                    </div>
                                    <div class="form-floating mb-3">
                                        <input type="tel" class="form-control  border border-primary border-2 rounded-3" name="telephone"
                                            id="floatingInput" placeholder="name@example.com">
                                        <label for="floatingInput" >Telephone</label>
                                    </div>
                                    <div class="form-floating mb-3">
                                        <input type="text"
                                            class="form-control border border-primary border-2 rounded-3 "
                                            id="floatingInput" placeholder="name@example.com" name="adresse">
                                        <label for="floatingInput" >Adresse</label>
                                    </div>

                                    <!-- <button type="submit" class="btn btn-primary">Enregistrer</button> -->

                            </div>
                            <div class="modal-footer">
                                <button type="reset" class="btn btn-danger" data-bs-dismiss="modal">Annuler</button>
                                <button type="submit" name="ajouter" class="btn btn-success">Enregistrer</button>
                            </div>

                            </form>
                        </div>
                    </div>
                </div>

            </div>
            <div class="col">
                <table class="table table-striped-columns border-primary">
                    <thead>
                        <tr>
                            <th>Matricule</th>
                            <th>Nom</th>
                            <th>Prénom</th>
                            <th>Telephone</th>
                            <th>Adresse</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% for(let item of result){ %>
                            <tr>
                                <td>
                                    <%= item.matricule %>
                                </td>
                                <td>
                                    <%= item.nom %>
                                </td>
                                <td>
                                    <%= item.prenom %>
                                </td>
                                <td>
                                    <%= item.telephone %>
                                </td>
                                <td>
                                    <%= item.adresse %>
                                </td>

                            </tr>

                            <% }%>
                    </tbody>
                </table>
            </div>
        </div>
    </div>


    <script src="../node_modules/bootstrap/dist/js/bootstrap.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
        integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz"
        crossorigin="anonymous"></script>
</body>

</html>